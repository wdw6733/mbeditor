MBEDITOR_BIND_HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:7073,http://127.0.0.1:7073
LOCAL_IMGBED_UPLOAD_URL=
LOCAL_IMGBED_UPLOAD_TOKEN=

# 生产(docker-compose.prod.yml)拉取的镜像标签;留空用 latest
MBEDITOR_TAG=latest

# 微信 API 网关(满足公众号 IP 白名单)。三者留空 = 直连 api.weixin.qq.com
# (出口 IP 非白名单会被拒)。真实值写本地 .env,切勿提交到公开仓库。
#   WECHAT_API_BASE    网关基址,如 https://<网关固定IP>:8443
#   WECHAT_PROXY_TOKEN 网关 Bearer 令牌(走网关时必填)
#   WECHAT_PROXY_CA    容器内证书路径,固定 /etc/mbeditor-certs/wechat-proxy.crt
#                      (宿主机 ./certs/wechat-proxy.crt 经 volume 挂载)
WECHAT_API_BASE=
WECHAT_PROXY_TOKEN=
WECHAT_PROXY_CA=

# BYOK AI 模型配置(自带 Key,key 只存本地数据卷,不经过任何第三方)。
# 推荐在编辑器「设置 → AI 引擎」里填写;也可用环境变量注入(二选一)。
#   LLM_PROVIDER  provider:openai_compat(通义/智谱/Kimi/DeepSeek 等)或 anthropic
#   LLM_BASE_URL  OpenAI 兼容端点,例如 https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL     模型名,例如 qwen-plus / deepseek-chat / glm-4-plus / moonshot-v1-8k
#   LLM_API_KEY   你的 API Key
LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

